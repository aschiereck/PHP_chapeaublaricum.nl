<script>
    $(function(){

        var scope = getPageBuilderScope();

        //Set modules
        <?php foreach ($pageBuilderModules as $module) { ?>
        scope.addModule('<?php echo addslashes(json_encode($module)); ?>');
        <?php } ?>


        //Hide / show form elements
        $('#fc-allowSeoIndex').bind('change', function() {

            var elems = $('.show-for-seo');
            if($(this).prop('checked'))
            {
                elems.show();
            }
            else
            {
                elems.hide();
            }
        }).trigger('change');

        //Initialize grid
        var options = {
            width: 12,
            float: false,
            resizable : {
                autoHide: true,
                handles: 'e,w'
            }
        };
        $('#pagebuilder-stack').gridstack(options);
        $('#pagebuilder-stack').on('change', function(event, items) {
            scope.updateFromGridStack();
        });

        //Set pagerows
        scope.setUrlPrefix("/<?php echo ADMIN_SUFFIX ?>/<?php echo $this->viewModel->site->getId(); ?>");
        scope.initializeFromJson('<?php echo addslashes($json) ?>');
    });

    /**
     * Also used by iframes
     * @returns {*}
     */
    function getPageBuilderScope()
    {
        var scope = angular.element(document.getElementById('pageBlockList')).scope();
        return scope;
    }
</script>