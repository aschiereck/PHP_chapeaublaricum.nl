<?php
/**
 * @var array $pages
 * @var \App\Model\Link\AbstractLink $link
 */
use App\Model\Link\AbstractLink;
?>
<div class="col-sm-12">
    <?php echo $this->Form()->select('linkType', $this->__('Waar moet de link naartoe verwijzen'), AbstractLink::getLinkOptions(), $link ? $link->getType() : 0);  ?>
</div>
<div class="col-sm-12" id="link-page-selection">
    <?php $value = $link && $link->getType() == \App\Model\Link\PageLink::TYPE ? $link->getPage()->getId() : 0; ?>
    <?php echo $this->Form()->select('linkPage', $this->__('Pagina'), $pages, $value);  ?>
</div>
<div class="col-sm-12" id="link-external-url">
    <?php $value = $link && $link->getType() == \App\Model\Link\ExternalLink::TYPE ? $link->getUrl() : ''; ?>
    <?php echo $this->Form()->text('linkUrl', $this->__('Url verwijzing'), $value);  ?>
</div>

<script>
    $(function(){
        $('#fc-linkType').bind('change', function() {

            var val = $(this).val();
            if (val == '<?php echo \App\Model\Link\PageLink::TYPE ?>') {
                $('#link-page-selection').show();
                $('#link-external-url').hide();
            }
            else {
                $('#link-page-selection').hide();
                $('#link-external-url').show();
            }
        }).trigger('change');
    })
</script>