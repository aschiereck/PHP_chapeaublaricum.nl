<?php
/**
 * @var \App\View\Admin\Model\View $this
 */
$flash = $this->viewModel->flashMessageHandler;
?>
<section id="flash-messages">

<?php foreach($flash->getMessages(\App\Session\FlashMessageHandler::ERROR) as $message) { ?>
    <div class="alert alert-danger">
        <?php echo $message['message'] ?>
    </div>
<?php } ?>

<?php foreach($flash->getMessages(\App\Session\FlashMessageHandler::INFO) as $message) { ?>
    <div class="alert alert-info">
        <?php echo $message['message'] ?>
    </div>
<?php } ?>


<?php foreach($flash->getMessages(\App\Session\FlashMessageHandler::WARNING) as $message) { ?>
    <div class="alert alert-warning">
        <?php echo $message['message'] ?>
    </div>
<?php } ?>


<?php foreach($flash->getMessages(\App\Session\FlashMessageHandler::SUCCESS) as $message) { ?>
    <div class="alert alert-success">
        <?php echo $message['message'] ?>
    </div>
<?php } ?>

</section>
