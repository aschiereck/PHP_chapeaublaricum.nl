<?php
/**
 * @var \App\View\Admin\Model\View $this
 */
$this->inlineScript()->prependFile('/assets/admin/js/site-selector.js');
?>

<?php if(count($this->viewModel->sites) == 1) { ?>

    <div class="portal-block site-block">
        <span><?php echo $this->__('U beheert nu:'); ?></span>
        <?php echo $this->viewModel->siteUrl; ?>
    </div>

<?php } else { ?>

    <div class="portal-block site-selector">
        <span>U beheert nu:</span>
        <select class="selectpicker portal form-control" id="siteSelector">
            <?php foreach($this->viewModel->sites as $site) { ?>
                <option <?php echo $site->getId() == $this->viewModel->site->getId() ? 'selected' : '' ?>
                        value="<?php echo $this->url(App\Action\Admin\Dashboard\IndexAction::ROUTE,['siteId'=>$site->getId()]) ?>">
                    <?php echo $site->getName() ?>
                </option>
            <?php } ?>
        </select>
    </div>

<?php } ?>