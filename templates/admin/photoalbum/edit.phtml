<script>
    /**
     * Set photo data
     */
    $(function() {
        var scope = angular.element(document.getElementById('overview')).scope();

        <?php foreach($photoAlbum->getPhotos() as $photo) { ?>
            <?php if($photo->isActive()) { ?>
                scope.add(
                    '<?php echo $photo->getId() ?>',
                    '<?php echo $this->image()->getExactResizeUrl($photo->getPhotoImage(),150,150); ?>',
                    '<?php echo $photo->getName() ?>',
                    '<?php echo $photo->getPosition() ?>'
                );
            <?php } ?>
        <?php } ?>
    });

    /**
     * Sorting of album
     */
    function updateSorting(){

        //Create closure for list
        var sortableListHandler = function(list) {
            Sortable.create(list, {
                animation: 500,
                handle: ".icon-move",
                chosenClass: "sortable-chosen",
                onEnd: function (evt) {
                    var scope = angular.element(document.getElementById('overview')).scope();
                    var newOrder = [];
                    $('#overview .photo').each(function(){
                        newOrder.push($(this).attr('data-id'));
                    });
                    scope.updatePositions(newOrder);
                }
            });
        };
        sortableListHandler( document.getElementById('overview'));
    }

    $(function(){
        updateSorting();
    });

    /**
     * Image uploader
     */
    $(function () {
        var url = '<?php echo $this->adminUrl(\App\Action\Admin\PhotoAlbum\UploadPhotosAction::ROUTE, ['id'=>$photoAlbum->getId()]) ?>';
        var totalFiles = 0;
        var filesDone = 0;
        var uploadProgress = 0;

        var updateProgress = function(){
            var processProgress = parseInt(filesDone / totalFiles * 100, 10) * 0.5;
            var percentage = (uploadProgress + processProgress);

            if(percentage > 0)
            {
                $('#progress').show();

                $('#progress .progress-bar').css(
                    'width',
                    percentage + '%'
                );
            }
        };

        $('#fileupload').fileupload({
            url: url,
            dataType: 'json',
            submit : function(e, data){
                totalFiles++;
            },
            done: function (e, data) {
                $.each(data.result.files, function (index, file) {
                    if(file.error)
                    {
                        $('<p/>').html(file.name + ' - ' + file.error).addClass('error-message').appendTo('#uploaded-files');
                    }
                    else
                    {
                        $('<p/>').html(file.name).appendTo('#uploaded-files');
                    }

                    var scope = angular.element(document.getElementById('overview')).scope();
                    scope.add(
                        file.id,
                        file.url,
                        file.label,
                        file.position
                    );
                });
                filesDone++;
                updateProgress();
            },
            fail: function(e, data){
                alert('Er is fout ontstaan: ' + data.errorThrown.message);
                filesDone++;
                updateProgress();
            },
            progressall: function (e, data) {
                uploadProgress = parseInt(data.loaded / data.total * 100, 10) * 0.5;
                updateProgress();

            }
        }).prop('disabled', !$.support.fileInput)
            .parent().addClass($.support.fileInput ? undefined : 'disabled');
    });
</script>