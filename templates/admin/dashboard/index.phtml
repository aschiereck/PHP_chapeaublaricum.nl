<div class="row google-analytics">
    <div class="col-sm-4">
        <p class="title"><strong>SEO:</strong> <?php echo $this->__('Hoe goed scoort jouw website') ?></p>
        <div class="stars-block">
            <?php for($i =1; $i <= 5; $i++) { ?>

                <?php if($i <= floor($seoScore)) { ?>
                    <span class="icon-star text-primary"></span>
                <?php } else if(ceil($seoScore) == $i) { ?>
                    <span class="icon-star-half-empty"></span>
                <?php } else { ?>
                    <span class="icon-star-empty"></span>
                <?php } ?>

            <?php } ?>
        </div>
        <p class="caption">
            <?php if($seoScore < 1) { ?>
                <?php echo $this->__('Je website is nog niet optimaal vindbaar') ?>
            <?php } else if($seoScore < 2.5) { ?>
                <?php echo $this->__('Je website is goed vindbaar op focuswoorden') ?>
            <?php } else { ?>
                <?php echo $this->__('Je website is erg goed vindbaar op focuswoorden') ?>
            <?php } ?>
        </p>
    </div>
    <div class="col-sm-4">
        <p class="title"><?php echo $this->__('De meeste gebruikte focuswoorden in je website') ?></p>
        <div class="row">
            <div class="col-sm-6">
                <?php $counter = 1; ?>
                <?php foreach($focusWords as $focusWord=>$occurrence){ ?>

                    <p class="focus-word">
                        <strong><?php echo $counter ?>.</strong>
                        <?php echo $focusWord ?>
                        <span class="text-primary"><?php echo $occurrence ?>x</span>
                    </p>

                    <?php if($counter == 3) { ?>
                        </div>
                        <div class="col-sm-6">
                    <?php } ?>

                    <?php $counter++; ?>

                <?php } ?>
            </div>
        </div>
    </div>
</div>

