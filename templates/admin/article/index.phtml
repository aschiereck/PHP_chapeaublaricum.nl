<?php
/**
 * @var \App\View\Admin\Model\View $this
 * @var \App\Repository\Paginator $paginator
 * @var \App\Model\Article[] $articles
 */

$this->viewModel->title = 'Nieuwsberichten';
$this->viewModel->menu->setActive(\App\View\Admin\Model\Menu::MENU_CONTENT_ARTICLE);
?>
<div class="row">
    <div class="col-md-12 col-lg-9">
        <!-- Add btn -->
        <div class="add-btn">
            <div class="row">
                <div class="col-md-5 col-lg-5">
                    <a href="<?php echo $this->adminUrl(\App\Action\Admin\Article\EditAction::ROUTE) ?>" class="custom-btn add-form-control">
                        <span>Nieuwsbericht toevoegen</span>
                    </a>
                </div>
            </div>
        </div>
        <!-- Content inner -->
        <div class="content-inner">
            <table class="table">
                <thead>
                <tr>
                    <th>Naam</th>
                    <th>Status</th>
                    <th>Publicatie datum</th>
                    <th>SEO</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                <?php foreach($articles as $article) { ?>
                    <tr>
                        <td><?php echo $article->getName(); ?></td>
                        <td>
                            <?php if($article->isPublished()) { ?>
                                <span class="icon-checkmark"></span>
                            <?php } else { ?>
                                <span class="icon-clock"></span>
                            <?php } ?>
                        </td>
                        <td>
                            <?php echo $article->getPublishDate() ? $article->getPublishDate()->format(DATE_TIME_FORMAT) : '' ?>
                        </td>
                        <td>
                            <?php
                            switch($article->getSeoCompleteness())
                            {
                                case \App\Model\SeoCompleteness::GOOD:
                                    echo '<span class="icon-smile"></span>';
                                    break;
                                case \App\Model\SeoCompleteness::OK:
                                    echo '<span class="icon-neutral"></span>';
                                    break;
                                case \App\Model\SeoCompleteness::BAD:
                                    echo '<span class="icon-sad"></span>';
                                    break;
                            }
                            ?>
                        </td>
                        <td>
                            <div class="icon-block">
                                <a href="<?php echo $this->adminUrl(\App\Action\Admin\Article\EditAction::ROUTE, ['id'=>$article->getId()]) ?>" class="icon-settings"></a>
                                <a href="<?php echo $this->adminUrl(\App\Action\Admin\Article\DeleteAction::ROUTE, ['id'=>$article->getId()]) ?>" class="icon-rubbish"></a>
                            </div>
                        </td>
                    </tr>
                <?php } ?>
                </tbody>
            </table>

            <?php echo $this->render('admin::elements/paginator', ['paginator' => $paginator]); ?>

        </div>
        <i class="icon-clock" title="Laatste cron run op: <?php echo $lastCronJobRun ?>"></i>
    </div>
</div>


