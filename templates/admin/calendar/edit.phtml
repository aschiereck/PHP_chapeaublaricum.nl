<script>
    /**
     * Set data
     */
    $(function() {
        var scope = angular.element(document.getElementById('overview')).scope();

        <?php foreach($calendar->getEvents() as $event) { ?>
        scope.add(
            '<?php echo $event->getId() ?>',
            '<?php echo $event->getDateTime()->format('Y-m-d') ?>',
            '<?php echo $event->getDateTime()->format('H:i') ?>',
            '<?php echo $event->getName() ?>',
            '<?php echo $event->getLocation() ?>'
        );
        <?php } ?>
        scope.$apply();
    });
</script>