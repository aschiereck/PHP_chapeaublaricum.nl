<?php
/**
 * @var \App\View\Frontend\Model\View $this
 * @var \App\Model\PageBlock\PageBlockNewsArchive $block
 */

/** @var App\Model\Article[] $articles */
$paginator = $this->article()->getPaginator();
$articles = $paginator->getResults();
$chunks = array_chunk($articles, 2);
?>

<div class="row">
    <div class="col-sm-12">
        <div class="content">
            <h2 class="title-primary">Nieuwsarchief</h2>
        </div>
    </div>
</div>


<?php foreach($chunks as $chunk) { ?>
    <div class="row">
        <?php foreach($chunk as $article) { ?>
            <div class="article col-sm-6">
                <img src="<?php echo $this->image()->getExactResizeUrl($article->getArticleImage(),550,300); ?>" alt="" title="<?php echo htmlentities($article->getName()) ?>"/>
                <div class="content">
                    <h2><?php echo htmlentities($article->getName()) ?></h2>
                    <p><?php echo nl2br($article->getSummary()) ?></p>
                    <a href="<?php echo $this->link()->article($article); ?>" class="btn btn-secondary">Lees meer</a>
                </div>
            </div>
        <?php } ?>
    </div>
<?php } ?>

<?php echo $this->render('frontend::elements/paginator', ['paginator' => $paginator]); ?>
