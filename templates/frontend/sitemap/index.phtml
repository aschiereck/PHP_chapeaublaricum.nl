<?php
/**
 * @var \App\View\Frontend\Model\View $this
 */

echo '<?xml version="1.0" encoding="UTF-8" ?>';
echo '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">';

foreach($this->viewModel->site->getPages() as $page)
{
    if($page->allowSeoIndex())
    {
        echo $this->sitemap($this->link()->page($page), $page->getModifiedDate());
    }
}
foreach($this->viewModel->site->getArticles() as $article)
{
    echo $this->sitemap($this->link()->article($article), $article->getModifiedDate());
}
foreach($this->viewModel->site->getProjects() as $project)
{
    echo $this->sitemap($this->link()->project($project), $project->getModifiedDate());
}

echo '</urlset>';
