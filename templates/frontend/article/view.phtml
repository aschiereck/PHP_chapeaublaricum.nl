<script type="application/ld+json">
<?php
    $snippet = array(
        "@context" => "http://schema.org/",
        "@type" => "NewsArticle",
        "headline" => $article->getName(),
        "datePublished" => $article->getPublishDate()->format('Y-m-d\TH:i:s'),
        "dateModified" =>  $article->getPublishDate()->format('Y-m-d\TH:i:s'),
        "description" => $article->getSummary(),
        "mainEntityOfPage" => array(
            "@type" => "WebPage",
            "@id" => $this->link()->article($article)
        ),
    );

    if($article->getArticleImage())
    {
        $protocol = stripos($_SERVER['SERVER_PROTOCOL'],'https') === true ? 'https://' : 'http://';
        $snippet['image'] = array(
            "@type" => "ImageObject",
            "url" => $this->image()->getExactResizeUrl($article->getArticleImage(), 800, 600),
        );
    }

    echo json_encode($snippet, JSON_UNESCAPED_SLASHES )
?>

</script>

